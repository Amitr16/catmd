# Supabase (RAG corpus + user data)
# Using the NEW key names (sb_publishable is the old "anon" key — safe to bundle).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# AI — provider-agnostic; defaults to OpenAI
# For production: deploy the Cloudflare Worker in ./proxy, then set
# EXPO_PUBLIC_AI_BASE_URL to its URL and LEAVE the direct-key vars blank.
# The proxy holds the real OPENAI_API_KEY as a Cloudflare secret, so the
# APK bundle contains no plaintext key.
EXPO_PUBLIC_AI_PROVIDER=openai
EXPO_PUBLIC_AI_MODEL=gpt-4o-mini
EXPO_PUBLIC_AI_EMERGENCY_MODEL=claude-sonnet-4-6
EXPO_PUBLIC_ENABLE_AI=true
EXPO_PUBLIC_AI_BASE_URL=
# Shared app-secret matching the Worker's APP_SECRET secret. Raises the bar
# above casual scraping. Leave blank if the Worker has no APP_SECRET set.
EXPO_PUBLIC_AI_APP_SECRET=
# Direct keys — ONLY used when EXPO_PUBLIC_AI_BASE_URL is blank. Never
# ship a production APK with these populated.
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# RevenueCat (paywall)
EXPO_PUBLIC_RC_ANDROID_KEY=
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_ENABLE_PAYWALL=false
# Free-tier quota per calendar month for non-Pro users. Each mode has its
# own pool so the prevention-focused litter-box check doesn't steal the
# general-concern allowance (or vice versa).
EXPO_PUBLIC_FREE_SCANS_PER_MONTH=1
EXPO_PUBLIC_FREE_LITTER_BOX_SCANS_PER_MONTH=1
# Dev-only: force the app to behave as a Free user even though paywall is
# disabled. Useful for testing the paywall flow without RevenueCat set up.
EXPO_PUBLIC_DEV_FORCE_FREE=false

# Analytics (PostHog)
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_ENABLE_ANALYTICS=false
