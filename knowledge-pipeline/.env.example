# ─── OpenAI (required for steps 1, 3, 4, 6) ────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# Default models (override only if you know why)
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
EMBED_DIMS=1536

# ─── Supabase (required only for step 6 / embed_and_load) ──────────────────
# Create a new project at https://supabase.com — don't reuse Folio's project.
# Use the SERVICE ROLE key for the pipeline (it bypasses RLS).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...

# ─── Search API for source gathering (step 2) ──────────────────────────────
# Pick ONE. Brave is cheapest ($3/1k queries after free tier).
SEARCH_PROVIDER=brave            # brave | serper | google
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# ─── Pipeline tuning ───────────────────────────────────────────────────────
TARGET_TOPIC_COUNT=600           # step 1 target (500–800 is sensible)
SOURCES_PER_TOPIC=4              # step 2
RATE_LIMIT_RPS=1.0               # polite scraping
HTTP_TIMEOUT_S=30
CACHE_DIR=./data/raw_sources
CONFIDENCE_ACCEPT=0.80           # step 4 auto-accept threshold
CONFIDENCE_FLAG=0.60             # step 4 flag-for-review threshold
